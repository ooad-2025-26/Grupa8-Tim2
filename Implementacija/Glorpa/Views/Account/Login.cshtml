@model Glorpa.Models.ViewModels.LoginViewModel

<div class="row justify-content-center">

    <div class="col-md-5">

        <div class="card p-4 shadow-soft">

            <h2>Prijava</h2>

            <hr />

            <form asp-action="Login">

                <div asp-validation-summary="All"
                     class="text-danger">
                </div>

                <div class="mb-3">

                    <label asp-for="Email"></label>

                    <input asp-for="Email"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label asp-for="Password"></label>

                    <input asp-for="Password"
                           class="form-control" />

                </div>

                <button type="submit"
                        class="btn btn-primary">

                    Prijava

                </button>

            </form>

        </div>

    </div>

</div>