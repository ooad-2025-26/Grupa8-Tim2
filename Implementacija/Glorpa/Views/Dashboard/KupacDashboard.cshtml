@{
    ViewData["Title"] = "Panel kupca";
    Layout = "_KupacLayout";
}

<div class="text-center mb-4">

    <h1 class="display-3 fw-light">
        Dobar dan,
        <span class="text-primary fw-normal">
            @ViewBag.Ime
        </span>
        👋
    </h1>

    <p class="lead text-muted">
        Dobrodošli u Glorpu.
    </p>

</div>

<div class="glorpa-menu">

    <a asp-controller="Restoran"
           asp-action="Index"
           class="menu-item menu-top">

        <i class="bi bi-shop fs-1 mb-2"></i>

        <span>Restorani</span>

    </a>

    <a asp-controller="Narudzba"
           asp-action="MojeNarudzbe"
           class="menu-item menu-left">

        <i class="bi bi-box-seam fs-1 mb-2"></i>

        <span>Moje narudžbe</span>

    </a>

    <a asp-controller="Profil"
           asp-action="MojProfil"
           class="menu-item menu-right">

        <i class="bi bi-person-circle fs-1 mb-2"></i>

        <span>Moj profil</span>

    </a>

    <div class="menu-center">

        <img id="easterEggLogo"
             src="~/images/glorpa.png"
             alt="Glorpa"
             style="cursor:pointer;" />

    </div>

</div>
<audio id="cellTheme">

    <source src="/audio/perfectcell.mp3"
            type="audio/mpeg">

</audio>

<style>

    .glorpa-menu {
        position: relative;
        width: 500px;
        height: 500px;
        margin: 30px auto;
    }

    .menu-item {
        position: absolute;
        width: 220px;
        height: 220px;
        border-radius: 50%;
        text-decoration: none;
        color: white;
        font-weight: 600;
        font-size: 1.2rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        transition: all .25s ease;
        box-shadow: 0 12px 30px rgba(0,0,0,.18);
    }

        .menu-item:hover {
            transform: translateY(-15px);
            color: white;
        }

    .menu-top {
        top: 0;
        left: 140px;
        background: #2f66e8;
    }

    .menu-left {
        bottom: 30px;
        left: 20px;
        background: #1faa4b;
    }

    .menu-right {
        bottom: 30px;
        right: 20px;
        background: #7c8597;
    }

    .menu-center {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 140px;
        height: 140px;
        margin-left: -70px;
        margin-top: -70px;
        background: white;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        box-shadow: 0 12px 30px rgba(0,0,0,.18);
        z-index: 100;
    }

        .menu-center img {
            width: 105px;
        }
        .menu-center {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 140px;
    height: 140px;
    margin-left: -70px;
    margin-top: -70px;
    background: white;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0 12px 30px rgba(0,0,0,.18);
    z-index: 100;
}

        .menu-center img.cell-mode {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 50%;
        }

    @@media (max-width: 768px) {

        .glorpa-menu {
            transform: scale(.75);
            transform-origin: top center;
            margin-top: -30px;
        }
    }

</style>
<script>

    let aktivirano = false;

    document
        .getElementById("easterEggLogo")
        .addEventListener("click", function ()
        {
            if (aktivirano)
                return;

            aktivirano = true;

            this.src =
              "/images/perfect.png";
              this.classList.add("cell-mode");
            const audio =
                document.getElementById(
                    "cellTheme");

            audio.volume = 0.5;

            audio.play();

             Swal.fire({
        html: `
            <img src="/images/perfect.png"
                 style="width:100%;display:block;">
             Ovaj sistem je: 
        `,
        showConfirmButton: true,
        confirmButtonText: "Perfektan"
    });
        });

</script>