@model IEnumerable<Glorpa.Models.Dostava>

@{
    Layout = "_DostavljacLayout";
}

<h1 class="mb-4">
    Status dostave
</h1>

@if (!Model.Any())
{
    <div class="alert alert-secondary">
        Nemate aktivnih dostava.
    </div>
}
else
{
    <div class="row">

        @foreach (var dostava in Model)
        {
            var restoran =
                dostava.Narudzba?
                    .StavkeNarudzbe?
                    .FirstOrDefault()?
                    .Jelo?
                    .Restoran;

            <div class="col-lg-6 mb-4">

                <div class="card shadow p-4 h-100">

                    <h3>
                        Narudžba #@dostava.NarudzbaId
                    </h3>

                    <hr />

                    <p>
                        <strong>Kupac:</strong>
                        @dostava.Narudzba?.Korisnik?.Ime
                        @dostava.Narudzba?.Korisnik?.Prezime
                    </p>

                    <p>
                        <strong>Adresa kupca:</strong>
                        @dostava.Narudzba?.AdresaDostave
                    </p>

                    <p>
                        <strong>Restoran:</strong>
                        @restoran?.Naziv
                    </p>

                    <p>
                        <strong>Adresa restorana:</strong>
                        @restoran?.Adresa
                    </p>

                    <p>
                        <strong>Status:</strong>

                        <span class="badge bg-success">
                            @dostava.Status
                        </span>
                    </p>

                    <input type="hidden"
                           id="adresaRestorana_@dostava.Id"
                           value="@restoran?.Adresa" />

                    <input type="hidden"
                           id="adresaKupca_@dostava.Id"
                           value="@dostava.Narudzba?.AdresaDostave" />

                    <input type="hidden"
                           id="statusDostave_@dostava.Id"
                           value="@dostava.Status" />

                    <div class="d-flex gap-2 flex-wrap">

                        @if (dostava.Status == "CEKA_PREUZIMANJE")
                        {
                            <form asp-controller="Dostava"
                                  asp-action="SljedeciStatus"
                                  method="post">

                                <input type="hidden"
                                       name="id"
                                       value="@dostava.Id" />

                                <button type="submit"
                                        class="btn btn-primary">

                                    Preuzmi narudžbu

                                </button>

                            </form>
                        }
                        else if (dostava.Status == "PREUZETA")
                        {
                            <form asp-controller="Dostava"
                                  asp-action="SljedeciStatus"
                                  method="post">

                                <input type="hidden"
                                       name="id"
                                       value="@dostava.Id" />

                                <button type="submit"
                                        class="btn btn-warning">

                                    Kreni prema kupcu

                                </button>

                            </form>
                        }
                        else if (dostava.Status == "NA_PUTU")
                        {
                            <form asp-controller="Dostava"
                                  asp-action="SljedeciStatus"
                                  method="post"
                                  onsubmit="return confirm('Da li ste sigurni da želite završiti dostavu?');">

                                <input type="hidden"
                                       name="id"
                                       value="@dostava.Id" />

                                <button type="submit"
                                        class="btn btn-danger">

                                    Završi dostavu

                                </button>

                            </form>
                        }

                        <button type="button"
                                class="btn btn-info text-white toggleMapa"
                                data-id="@dostava.Id">

                            Prikaži mapu

                        </button>

                    </div>

                    <div id="mapaContainer_@dostava.Id"
                         style="display:none; margin-top:20px;">

                        <div id="map_@dostava.Id"
                             style="height:450px; border-radius:10px;">
                        </div>

                    </div>

                </div>

            </div>
        }

    </div>
}

<link rel="stylesheet"
      href="https://unpkg.com/leaflet/dist/leaflet.css" />

<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

<script>

    document.querySelectorAll(".toggleMapa")
    .forEach(button => {

    let mapaKreirana = false;
    let mapa;

    button.addEventListener("click", async function () {

    let id = this.dataset.id;

    let container =
    document.getElementById("mapaContainer_" + id);

    if (container.style.display === "none")
    {
    container.style.display = "block";

    this.classList.remove("btn-info");
    this.classList.add("btn-success");

    this.innerText = "Sakrij mapu";

    if (!mapaKreirana)
    {
    let status =
    document.getElementById("statusDostave_" + id).value;

    let adresa;

    if (status === "CEKA_PREUZIMANJE")
    {
    adresa =
    document.getElementById("adresaRestorana_" + id).value;
    }
    else
    {
    adresa =
    document.getElementById("adresaKupca_" + id).value;
    }

    const odgovor =
    await fetch(
    "https://nominatim.openstreetmap.org/search?format=json&q="
    + encodeURIComponent(adresa));

    const podaci =
    await odgovor.json();

    if (podaci.length > 0)
    {
    let lat = parseFloat(podaci[0].lat);
    let lon = parseFloat(podaci[0].lon);

    mapa =
    L.map('map_' + id)
    .setView([lat, lon], 15);

    L.tileLayer(
    'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
    {
    attribution: '&copy; OpenStreetMap'
    })
    .addTo(mapa);

    L.marker([lat, lon])
    .addTo(mapa)
    .bindPopup(adresa)
    .openPopup();
    }

    mapaKreirana = true;
    }

    setTimeout(() => mapa.invalidateSize(), 100);
    }
    else
    {
    container.style.display = "none";

    this.classList.remove("btn-success");
    this.classList.add("btn-info");

    this.innerText = "Prikaži mapu";
    }

    });

    });

</script>