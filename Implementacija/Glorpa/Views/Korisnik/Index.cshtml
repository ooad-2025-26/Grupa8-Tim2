@model IEnumerable<Glorpa.Models.Korisnik>
@{
    Layout = "_AdminLayout";
}
<h1>Korisnici</h1>
<div class="mb-4">

    <a asp-action="Index"
           class="btn btn-secondary">
        Svi korisnici
    </a>

    <a asp-action="Kupci"
           class="btn btn-primary">
        Kupci
    </a>

    <a asp-action="Dostavljaci"
           class="btn btn-success">
        Dostavljači
    </a>

    <a asp-action="Admini"
           class="btn btn-dark">
        Administratori
    </a>

</div>
<div class="d-flex justify-content-between align-items-center mb-4">

   

    

</div>

<table class="table">
    <thead>
        <tr>
            <th>Ime</th>
            <th>Prezime</th>
            <th>Email</th>
            <th>Telefon</th>
            <th>Uloga</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Ime</td>
                <td>@item.Prezime</td>
                <td>@item.Email</td>
                <td>@item.PhoneNumber</td>
                <td>@item.Uloga</td>
                <td>
                    <div class="d-flex gap-2">

                        <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-warning">

                            <i class="bi bi-pencil-square"></i>
                            Uredi

                        </a>

                        <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-info text-white">

                            <i class="bi bi-info-circle"></i>
                            Detalji

                        </a>

                        <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-danger">

                            <i class="bi bi-trash"></i>
                            Obriši

                        </a>

                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>