@model IEnumerable<Glorpa.Models.KorpaStavka>
@{
    Layout = "_KupacLayout";
}
@{
    double ukupno = 0;
}
@{
    bool praznaKorpa = !Model.Any();
}

<h1 class="mb-3">
    Moja korpa
</h1>

<a href="javascript:history.back();"
       class="btn btn-danger mb-4">

    ← Nastavi kupovinu

</a>
<table class="table table-striped">

    <thead>

        <tr>
            <th>Jelo</th>
            <th>Količina</th>
            <th>Cijena</th>
            <th>Akcija</th>
        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            ukupno += item.Jelo.Cijena * item.Kolicina;

            <tr>

                <td>@item.Jelo.Naziv</td>

                <td>

                    <form asp-action="PromijeniKolicinu"
                          method="post"
                          class="d-flex align-items-center gap-2">

                        <input type="hidden"
                               name="id"
                               value="@item.Id" />

                        <button type="submit"
                                name="akcija"
                                value="minus"
                                class="btn btn-sm btn-outline-secondary">

                            -

                        </button>

                        <span class="fw-bold">
                            @item.Kolicina
                        </span>

                        <button type="submit"
                                name="akcija"
                                value="plus"
                                class="btn btn-sm btn-outline-secondary">

                            +

                        </button>

                    </form>

                </td>

                <td>
                    @(item.Jelo.Cijena * item.Kolicina) KM
                </td>

                <td>

                    <form asp-action="Ukloni"
                          method="post">

                        <input type="hidden"
                               name="id"
                               value="@item.Id" />

                        <button type="submit"
                                class="btn btn-danger btn-sm">

                            Ukloni

                        </button>

                    </form>

                </td>

            </tr>
        }

    </tbody>

</table>

<div class="card shadow-sm p-4 mt-4">

    <h5>
        Cijena hrane:
        @ukupno KM
    </h5>

    <h5>
        Dostava:
        @(praznaKorpa ? 0 : 5) KM
    </h5>

    <hr />

    <h3 class="text-success">
        Ukupno:
        @(ukupno + (praznaKorpa ? 0 : 5)) KM
    </h3>

    <form asp-action="Checkout" method="post">

        <div class="mt-4">

            <label class="fw-bold">
                Način plaćanja
            </label>

            <div class="form-check mt-2">

                <input class="form-check-input"
                       type="radio"
                       name="nacinPlacanja"
                       value="Kes"
                       checked />

                <label class="form-check-label">
                    Keš
                </label>

            </div>

            <div class="form-check">

                <input class="form-check-input"
                       type="radio"
                       name="nacinPlacanja"
                       value="Karticno" />

                <label class="form-check-label">
                    Kartično
                </label>

            </div>

        </div>

        @if (TempData["Greska"] != null)
        {
            <div class="alert alert-danger mt-3">

                @TempData["Greska"]

                <br />

                <a asp-controller="Profil"
                       asp-action="MojProfil">

                    Kliknite ovdje da unesete adresu.

                </a>

            </div>
        }
        <div class="mt-4">

            @if (praznaKorpa)
            {
                <button type="button"
                        class="btn btn-secondary btn-lg"
                        disabled>

                    Korpa je prazna

                </button>
            }
            else
            {
                <button type="submit"
                        class="btn btn-success btn-lg">

                    Potvrdi narudžbu

                </button>
            }

        </div>

    </form>

</div>