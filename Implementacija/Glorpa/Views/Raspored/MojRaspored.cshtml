@{
    Layout = "_DostavljacLayout";
}
@{
    var zakljucaniDani =
        ViewBag.ZakljucaniDani
        as List<string>;
}
@using Glorpa.Models

@{
    var termini =
        ViewBag.Termini
        as List<Termin>;
}

<h1 class="mb-4">
    Moj raspored
</h1>

<div class="mb-4">

@if (ViewBag.UkupnoSati >= 35)
{
    <h4 class="text-success">
        Ukupno sati:
        @ViewBag.UkupnoSati / 35 ✅
    </h4>
}
else
{
    <h4 class="text-danger">
        Ukupno sati:
        @ViewBag.UkupnoSati / 35
    </h4>
}

</div>

<div id="kontejnerKartica"
     class="d-flex gap-3 align-items-start overflow-auto">

    @foreach (var dan in ViewBag.Dani)
    {
        bool zakljucan =
            zakljucaniDani != null &&
            zakljucaniDani.Contains(dan);
            var terminiDana =
    termini?
    .Where(t => t.Dan == dan)
    .ToList();
        <div class="karticaDana @(zakljucan ? "zakljucana" : "")"
             data-dan="@dan">

            <div class="naslovDana">
                @dan
            </div>

            <div class="sazetak">

                <hr />

               @if (terminiDana != null &&
     terminiDana.Any())
{
    foreach (var termin in terminiDana)
    {
        <p>
            @termin.Pocetak.ToString("HH:mm")
            -
            @termin.Kraj.ToString("HH:mm")
        </p>
    }

    <p class="fw-bold">

        @terminiDana.Sum(t => t.Trajanje)
        sati

    </p>
}
else
{
    <p>
        Nema termina
    </p>

    <p class="fw-bold">
        0 sati
    </p>
}

            </div>

        </div>
    }

</div>

<style>

    .karticaDana {
        width: 220px;
        min-width: 220px;
        min-height: 180px;
        padding: 20px;
        border-radius: 15px;
        background: white;
        box-shadow: 0 0 10px rgba(0,0,0,0.15);
        cursor: pointer;
        transition: all .3s ease;
        overflow: hidden;
        flex: none;
    }

        .karticaDana:not(.aktivna) {
            width: 220px;
        }

        .karticaDana.aktivna {
            width: 420px;
            min-height: 750px;
        }
        .karticaDana.zakljucana
{
    background:#f3f3f3;

    opacity:0.85;
}

.karticaDana.zakljucana .naslovDana::after
{
    content:" 🔒";
}
    .naslovDana {
        font-size: 26px;
        font-weight: bold;
        text-align: center;
        margin-bottom: 15px;
    }

    .sazetak {
        text-align: center;
    }

    .editor {
        display: none;
    }

    .karticaDana.aktivna .editor {
        display: block;
    }

    .karticaDana.aktivna .sazetak {
        display: none;
    }

    .slot {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 6px 0;
        border-bottom: 1px solid #ddd;
    }

</style>

<script>

    let aktivnaKartica = null;

    document
    .querySelectorAll(".karticaDana")
    .forEach(kartica =>
    {
        kartica.addEventListener("click", function (e)
        {
            if(this.classList.contains("zakljucana"))
{
    return;
}
            if (
                e.target.tagName === "INPUT" ||
                e.target.tagName === "BUTTON"
            )
            {
                return;
            }

            if (aktivnaKartica === this)
            {
                return;
            }

            if (aktivnaKartica)
            {
                aktivnaKartica
                    .classList
                    .remove("aktivna");
            }

            this.classList.add("aktivna");

            aktivnaKartica = this;

            let postojeciEditor =
                this.querySelector(".editor");

            if (postojeciEditor)
            {
                return;
            }

            let editor =
                document.createElement("div");

            editor.classList.add("editor");

            let html = "";

            @foreach (int sat in ViewBag.Sati)
            {
                    <text>

                        html += `
                        <div class="slot">

                                <span>@sat-@(@sat + 1)</span>

                                          <input type="checkbox"
                       value="@sat">

                        </div>
                        `;

                    </text>
            }

               html += `
    <hr>

    <button type="button"
            class="btn btn-dark w-100 btnSacuvajDan">

        Sačuvaj dan

    </button>
            `;

            editor.innerHTML = html;

            this.appendChild(editor);
        });
    });
         document.addEventListener("click", async function(e)
    {
        if(
            e.target.classList.contains(
                "btnSacuvajDan")
        )
        {
            let kartica =
                e.target.closest(".karticaDana");

            let dan =
                kartica.dataset.dan;
                    let sati = [];

    kartica
    .querySelectorAll(
        "input[type='checkbox']:checked")
    .forEach(x =>
    {
        sati.push(
            parseInt(x.value));
    });

            let odgovor =
    await fetch(
        "/Raspored/SacuvajDan",
        {
            method:"POST",

            headers:
            {
                "Content-Type":
                "application/json"
            },

               body: JSON.stringify(
    {
        dan: dan,
        sati: sati
    })
        });

 if(odgovor.ok)
{
    location.reload();
}
        }
    });

</script>