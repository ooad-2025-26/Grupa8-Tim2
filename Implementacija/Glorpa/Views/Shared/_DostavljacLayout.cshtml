<!DOCTYPE html>
<html lang="bs">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Glorpa Dostavljač</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">

        <div class="container">

            <a class="navbar-brand d-flex align-items-center"
                   asp-controller="Dashboard"
                   asp-action="Index">

                <img src="~/images/glorpa.png"
                     alt="Glorpa"
                     style="height:45px;" />

            </a>

            <ul class="navbar-nav ms-auto align-items-center">

                <li class="nav-item">
                    <a asp-controller="Dostava"
                           asp-action="StatusDostave"
                           class="nav-link">
                        Status dostave
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Dostava"
                           asp-action="MojeDostave"
                           class="nav-link">
                        Moje dostave
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Zarada"
                           asp-action="MojaZarada"
                           class="nav-link">
                        Zarada
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="ZahtjevPodrske"
                           asp-action="Create"
                           class="nav-link">
                        Podrška
                    </a>
                </li>

                <li class="nav-item ms-3">
                    <span class="nav-link">
                        Pozdrav @User.Identity.Name
                    </span>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                           asp-controller="Account"
                           asp-action="Logout">
                        Logout
                    </a>
                </li>

            </ul>

        </div>

    </nav>

    <main class="container mt-4">

        @RenderBody()

    </main>

</body>

</html>