<!DOCTYPE html>
<html lang="bs">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Glorpa</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">

        <div class="container">

            <a class="navbar-brand d-flex align-items-center"
                   asp-controller="Dashboard"
                   asp-action="Index">

                <img src="~/images/glorpa.png"
                     alt="Glorpa"
                     style="height:45px;" />

            </a>

            <ul class="navbar-nav ms-auto align-items-center">

                <li class="nav-item">
                    <a class="nav-link"
                           asp-controller="Restoran"
                           asp-action="Index">
                        Restorani
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                           asp-controller="Korpa"
                           asp-action="Index">
                        Korpa
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                           asp-controller="Narudzba"
                           asp-action="MojeNarudzbe">
                        Moje narudžbe
                    </a>
                </li>

                <li class="nav-item ms-3">
                    <span class="nav-link">
                        Pozdrav @User.Identity.Name
                    </span>
                </li>

                <li class="nav-item">
                    <a class="nav-link"
                           asp-controller="Account"
                           asp-action="Logout">
                        Logout
                    </a>
                </li>

            </ul>

        </div>

    </nav>

    <main class="container mt-4">

        @RenderBody()

    </main>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>



</body>

</html>
<script>

    async function provjeriNotifikacije()
    {
    try
    {
    const response =
    await fetch(
    '/Narudzba/ProvjeriNotifikacije');

    const data =
    await response.json();

    if (data.ima)
    {
    Swal.fire({
    icon: 'info',
    title: 'Status dostave',
    text: data.poruka,
    confirmButtonText: 'U redu'
    });
    }
    }
    catch
    {
    // ignoriši greške
    }
    }

    setInterval(
    provjeriNotifikacije,
    10000);

</script>