<!DOCTYPE html>
<html lang="bs">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Glorpa</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <link rel="stylesheet" href="~/css/site.css" />

</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">

        <div class="container">

            
            <a class="navbar-brand d-flex align-items-center"
                   asp-controller="Home"
                   asp-action="Index">

                <img src="~/images/glorpa.png"
                     alt="Glorpa"
                     style="height:45px;" />

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="navbarNav">

                <ul class="navbar-nav ms-auto">

                    @if (!User.Identity.IsAuthenticated)
                    {
                        

                        <li class="nav-item">

                            <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Login">

                                Prijava

                            </a>

                        </li>
                    }
                    else
                    {
                        <li class="nav-item">

                            <a class="nav-link"
                                   asp-controller="Korisnik"
                                   asp-action="Index">

                                <i class="bi bi-people"></i>
                                Korisnici

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                                   asp-controller="Narudzba"
                                   asp-action="Index">

                                <i class="bi bi-bag"></i>
                                Narudžbe

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                                   asp-controller="Dostava"
                                   asp-action="Index">

                                <i class="bi bi-bicycle"></i>
                                Dostava

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                                   asp-controller="Zarada"
                                   asp-action="Index">

                                <i class="bi bi-cash-stack"></i>
                                Zarada

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                                   asp-controller="VremenskiUslovi"
                                   asp-action="Index">

                                Vremenski uslovi

                            </a>

                        </li>

                        <li class="nav-item">

                            <span class="nav-link">

                                Pozdrav @User.Identity.Name

                            </span>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Logout">

                                Logout

                            </a>

                        </li>
                    }

                </ul>

            </div>

        </div>

    </nav>

    <main class="container mt-5 mb-5">

        @RenderBody()

    </main>

    <footer class="bg-dark text-light text-center p-3 mt-5">

        <div class="container">

            <small>
                © 2026 Glorpa — Sistem za upravljanje dostavom hrane
            </small>

        </div>

    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>