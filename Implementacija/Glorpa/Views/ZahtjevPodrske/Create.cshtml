@model Glorpa.Models.ZahtjevPodrske

@{
    Layout = "_DostavljacLayout";
}

<h2 class="mb-4">
    Podrška
</h2>

<form asp-action="Create"
      method="post">

    <div class="mb-3">

        <label class="form-label">
            Tip zahtjeva
        </label>

        <select asp-for="TipZahtjeva"
                class="form-control">

            <option value="TEHNICKI_PROBLEM">
                Tehnički problem
            </option>

            <option value="KUPAC_PROBLEM">
                Problem sa kupcem
            </option>

            <option value="UNIŠTENA_DOSTAVA">
                Uništena dostava
            </option>

            <option value="NEZGODA_U_RADU">
                Nezgoda u radu
            </option>

            <option value="OSTALO">
                Ostalo
            </option>

        </select>

    </div>

    <div class="mb-3">

        <label class="form-label">
            Opis problema
        </label>

        <textarea asp-for="Opis"
                  rows="6"
                      class="form-control">
        </textarea>

        </div>

        <button type="submit"
                class="btn btn-danger">

            Pošalji zahtjev

        </button>

    </form>