@model IEnumerable<Glorpa.Models.Zarada>

@{
    Layout = "_DostavljacLayout";
}

<h1 class="mb-4">
    Zarada
</h1>

<div class="card shadow p-4 mb-4">

    <h4>
        Stanje u kasi
    </h4>

    <h2 class="text-success">
        @Convert.ToDouble(ViewBag.Ukupno).ToString("F2") KM
    </h2>
    <hr />

    <h4 class="text-danger">
        Dug: @Convert.ToDouble(ViewBag.Dug).ToString("F2") KM
    </h4>
    @if (ViewBag.Dug >= 500)
    {
        <div class="alert alert-danger mt-3">

            Vaš dug je dostigao 500 KM.
            Ne možete primati nove dostave dok ne smanjite dug.

        </div>
    }
    <form asp-action="NamiriDug"
          method="post"
          class="mt-3">

        <button type="submit"
                class="btn btn-danger fw-bold">

            Namiri dug iz kase

        </button>

    </form>
</div>

<table class="table table-striped">

    <thead>

        <tr>

            <th>Datum</th>

            <th>Iznos</th>

            <th>Tip</th>

        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>
                    @item.Datum.ToString("dd.MM.yyyy HH:mm")
                </td>

                <td>
                    @item.Iznos KM
                </td>

                <td>
                    @item.TipZarade
                </td>

            </tr>
        }

    </tbody>

</table>