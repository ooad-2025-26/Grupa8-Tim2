@model Glorpa.Models.ViewModels.RegisterViewModel
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Registracija kupca";
}
<div class="row justify-content-center">

    <div class="col-md-6">

        <div class="card p-4 shadow-soft">

            <h2>Registracija kupca</h2>

            <hr />

            <form asp-controller="Account"
                  asp-action="RegisterKupac"
                  method="post">
                <input type="hidden"
                       name="uloga"
                       value="@((ViewBag.Uloga ?? Glorpa.Enums.TipKorisnika.Kupac).ToString())" />
                <div asp-validation-summary="All"
                     class="text-danger">
                </div>

                <div class="mb-3">
                    <label asp-for="Ime"></label>
                    <input asp-for="Ime"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Prezime"></label>
                    <input asp-for="Prezime"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Email"></label>
                    <input asp-for="Email"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Telefon"></label>
                    <input asp-for="Telefon"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Password"></label>
                    <input asp-for="Password"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword"
                           class="form-control" />
                </div>

                <button type="submit"
                        class="btn btn-success">
                    Registruj se
                </button>

            </form>

        </div>

    </div>

</div>