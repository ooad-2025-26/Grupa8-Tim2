@model Glorpa.Models.Narudzba

<h1>Obriši narudžbu</h1>

<h3>Da li ste sigurni da želite obrisati ovu narudžbu?</h3>

<div>
    <hr />

    <dl>
        <dt>Datum</dt>
        <dd>@Model.Datum</dd>

        <dt>Status</dt>
        <dd>@Model.Status</dd>

        <dt>Ukupna cijena</dt>
        <dd>@Model.UkupnaCijena</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">
            Obriši
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Nazad
        </a>
    </form>
</div>