@model Glorpa.Models.Narudzba

@{
    Layout = "_AdminLayout";
}

<h2>Dodjela narudžbe</h2>

<hr />

<div class="card p-4">

    <p>
        <strong>Kupac:</strong>
        @Model.Korisnik?.Ime
        @Model.Korisnik?.Prezime
    </p>

    <p>
        <strong>Email:</strong>
        @Model.Korisnik?.Email
    </p>

    <p>
        <strong>Adresa:</strong>
        @Model.AdresaDostave
    </p>

    <p>
        <strong>Ukupna cijena:</strong>
        @Model.UkupnaCijena KM
    </p>

    <form asp-action="DodijeliNarudzbu"
          method="post">

        <input type="hidden"
               name="narudzbaId"
               value="@Model.Id" />

        <div class="mb-3">

            <label>
                Odaberi dostavljača
            </label>

            <select name="dostavljacId"
                    class="form-control">

                @foreach (var d in ViewBag.Dostavljaci)
                {
                    <option value="@d.Id">
                        @d.Ime @d.Prezime
                    </option>
                }

            </select>

        </div>

        <button type="submit"
                class="btn btn-success">

            Dodijeli

        </button>

    </form>

</div>