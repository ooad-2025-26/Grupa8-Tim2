@model IEnumerable<Glorpa.Models.Narudzba>
@{
    Layout = "_AdminLayout";
}
<h1>Narudzbe</h1>



<table class="table">

    <thead>
        <tr>
            <th>Datum</th>
            <th>Status</th>
            <th>Dodjela</th>
            <th>UkupnaCijena</th>
            <th>NacinPlacanja</th>
            <th>Korisnik</th>
            <th>Akcije</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.Datum</td>

                <td>
                    @item.Status
                </td>

                <td>

                    @if (item.Dostava == null)
                    {
                        <span class="badge bg-danger">
                            Nedodijeljena
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            Dodijeljena
                        </span>
                    }

                </td>

                <td>@item.UkupnaCijena</td>

                <td>@item.NacinPlacanja</td>

                <td>@item.Korisnik?.Ime</td>

                <td>

                    <div class="d-flex gap-2">

                        @if (item.Dostava == null)
                        {
                            <a asp-action="Dodijeli"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-success">

                                <i class="bi bi-person-check"></i>
                                Dodijeli

                            </a>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-secondary"
                                    disabled>

                                Dodijeljena

                            </button>
                        }

                        <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-info text-white">

                            <i class="bi bi-info-circle"></i>
                            Detalji

                        </a>

                        <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-danger">

                            <i class="bi bi-trash"></i>
                            Obriši

                        </a>

                    </div>

                </td>

            </tr>
        }

    </tbody>

</table>