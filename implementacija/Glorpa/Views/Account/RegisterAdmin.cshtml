@model Glorpa.Models.ViewModels.RegisterViewModel

@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Registracija administratora";
}

<h2>Registracija administratora</h2>
<form asp-controller="Account"
      asp-action="RegisterAdmin"
      method="post">

    <div asp-validation-summary="All"
         class="text-danger">
    </div>

    <div class="mb-3">
        <label asp-for="Ime"></label>
        <input asp-for="Ime" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Telefon"></label>
        <input asp-for="Telefon" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Prezime"></label>
        <input asp-for="Prezime" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Password"></label>
        <input asp-for="Password"
               type="password"
               class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="ConfirmPassword"></label>

        <input asp-for="ConfirmPassword"
               type="password"
               class="form-control" />
    </div>
    <button type="submit"
            class="btn btn-dark">
        Registruj administratora
    </button>

</form>