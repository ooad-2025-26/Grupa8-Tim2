@{
    ViewData["Title"] = "Administratorski panel";
}

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Panel administratora";
}

@inject Glorpa.Data.DataContext _context

@{
    var brojZahtjeva =
        _context.ZahtjeviPodrske
        .Count(x => x.Status != "OBRADJEN");
}

<div class="text-center">

    <h1 class="display-4">
        Administratorski panel
    </h1>

    <p class="lead">
        Upravljanje sistemom Glorpa.
    </p>

    <hr />

    <div class="row justify-content-center mt-5 g-4">

        <div class="col-md-3">

            <a asp-controller="Korisnik"
                   asp-action="Index"
                   class="text-decoration-none">

                <div class="card shadow-sm border-0 h-100">

                    <div class="card-body text-center p-4">

                        <i class="bi bi-people-fill
                            text-primary"
                               style="font-size:60px;">
                        </i>

                        <h4 class="mt-3">
                            Korisnici
                        </h4>

                    </div>

                </div>

            </a>

        </div>

        <div class="col-md-3">

            <a asp-controller="Narudzba"
                   asp-action="Index"
                   class="text-decoration-none">

                <div class="card shadow-sm border-0 h-100">

                    <div class="card-body text-center p-4">

                        <i class="bi bi-bag-check-fill
                            text-success"
                               style="font-size:60px;">
                        </i>

                        <h4 class="mt-3">
                            Narudžbe
                        </h4>

                    </div>

                </div>

            </a>

        </div>

        <div class="col-md-3">

            <a asp-controller="Dostava"
                   asp-action="Index"
                   class="text-decoration-none">

                <div class="card shadow-sm border-0 h-100">

                    <div class="card-body text-center p-4">

                        <i class="bi bi-truck
                            text-warning"
                               style="font-size:60px;">
                        </i>

                        <h4 class="mt-3">
                            Dostave
                        </h4>

                    </div>

                </div>

            </a>

        </div>

        <div class="col-md-3">

            <a asp-controller="ZahtjevPodrske"
                   asp-action="Index"
                   class="text-decoration-none">

                <div class="card shadow-sm border-0 h-100 position-relative">

                    @if (brojZahtjeva > 0)
                    {
                        <span class="position-absolute
                            top-0
                            start-100
                            translate-middle
                            badge
                            rounded-pill
                            bg-danger">

                            @brojZahtjeva

                        </span>
                    }

                    <div class="card-body text-center p-4">

                        <i class="bi bi-headset
                            text-danger"
                               style="font-size:60px;">
                        </i>

                        <h4 class="mt-3">
                            Podrška
                        </h4>

                    </div>

                </div>

            </a>

        </div>

    </div>

</div>