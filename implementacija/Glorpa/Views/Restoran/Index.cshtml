@model IEnumerable<Glorpa.Models.Restoran>
@{
    Layout = "_KupacLayout";
}
<h1 class="mb-4">Restorani</h1>
<div class="mb-4">

    <div class="input-group shadow-sm">

        <span class="input-group-text bg-white">
            🔍
        </span>

        <input type="text"
               id="searchRestoran"
               class="form-control"
               placeholder="Pretraži restoran ili adresu..." />

    </div>

</div>
<div class="mb-4">

    <button class="btn btn-outline-secondary tagFilter"
            data-tag="">
        Svi
    </button>

    <button class="btn btn-outline-secondary tagFilter"
            data-tag="BURGER">
        🍔 Burger
    </button>

    <button class="btn btn-outline-secondary tagFilter"
            data-tag="PIZZA">
        🍕 Pizza
    </button>

    <button class="btn btn-outline-secondary tagFilter"
            data-tag="ROSTILJ">
        🥩 Roštilj
    </button>

    <button class="btn btn-outline-secondary tagFilter"
            data-tag="PASTA">
        🍝 Pasta
    </button>

    <button class="btn btn-outline-secondary tagFilter"
            data-tag="TRADICIONALNO">
        🥣 Tradicionalno
    </button>

</div>

<div class="row">

    @foreach (var restoran in Model)
    {
        <div class="col-md-4 mb-4 karticaRestoran"
             data-naziv="@restoran.Naziv"
             data-adresa="@restoran.Adresa"
             data-tagovi="@string.Join(",", restoran.Jela.SelectMany(j => j.Tagovi.Split(',')))">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h4>@restoran.Naziv</h4>

                    <p class="text-muted">
                        @restoran.Adresa
                    </p>

                    <a asp-action="Jela"
                           asp-route-id="@restoran.Id"
                           class="btn btn-primary">

                        Pogledaj jelovnik

                    </a>

                </div>

            </div>

        </div>
    }



</div>

<script>

    document
        .getElementById("searchRestoran")
        .addEventListener("input", function ()
        {
            let tekst =
                this.value.toLowerCase();

            document
                .querySelectorAll(".karticaRestoran")
                .forEach(kartica =>
                {
                    let naziv =
                        kartica.dataset.naziv.toLowerCase();

                    let adresa =
                        kartica.dataset.adresa.toLowerCase();

                    let prikazi =
                        naziv.includes(tekst)
                        ||
                        adresa.includes(tekst);

                    kartica.style.display =
                        prikazi
                            ? ""
                            : "none";
                });
        });

</script>
<script>

    document
        .querySelectorAll(".tagFilter")
        .forEach(btn =>
        {
            btn.addEventListener("click", function ()
            {
                let trazeniTag =
                    this.dataset.tag;

                document
                    .querySelectorAll(".karticaRestoran")
                    .forEach(kartica =>
                    {
                        let tagovi =
                            kartica.dataset.tagovi
                            .toUpperCase();

                        if (
                            trazeniTag === ""
                        )
                        {
                            kartica.style.display =
                                "";
                        }
                        else
                        {
                            kartica.style.display =
                                tagovi.includes(
                                    trazeniTag)
                                    ? ""
                                    : "none";
                        }
                    });
            });
        });

</script>